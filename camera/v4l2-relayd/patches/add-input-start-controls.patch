+static gboolean
+input_start_control_parse (const gchar  *spec,
+                           gchar       **device,
+                           gchar       **control,
+                           gint64       *value)
+{
+  const gchar *colon;
+  const gchar *equals;
+  gchar *end = NULL;
+  gint64 parsed_value;
+
+  colon = strrchr (spec, ':');
+  equals = colon != NULL ? strchr (colon + 1, '=') : NULL;
+  if (colon == NULL || colon == spec || equals == NULL ||
+      equals == colon + 1 || equals[1] == '\0')
+    return FALSE;
+
+  errno = 0;
+  parsed_value = g_ascii_strtoll (equals + 1, &end, 0);
+  if (errno == ERANGE || end == equals + 1 || *end != '\0')
+    return FALSE;
+
+  if (device != NULL)
+    *device = g_strndup (spec, colon - spec);
+  if (control != NULL)
+    *control = g_strndup (colon + 1, equals - colon - 1);
+  if (value != NULL)
+    *value = parsed_value;
+
+  return TRUE;
+}
+
+static void
+input_start_controls_validate ()
+{
+  guint i;
+
+  if (opt_input_start_controls == NULL)
+    return;
+
+  for (i = 0; opt_input_start_controls[i] != NULL; i++) {
+    if (!input_start_control_parse (opt_input_start_controls[i],
+                                    NULL, NULL, NULL)) {
+      g_printerr ("invalid input-start control: %s\n",
+                  opt_input_start_controls[i]);
+      exit (1);
+    }
+  }
+}
